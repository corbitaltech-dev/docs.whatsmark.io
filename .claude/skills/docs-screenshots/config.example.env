# Copy this file to `.env.screenshots` in the docs repo root and fill it in.
# `.env.screenshots` holds a password: add it to .gitignore and never commit it.

# --- Required ---------------------------------------------------------------
# Address of the app to capture, without a trailing slash.
SHOT_BASE_URL=http://tenant1.example.test
# Login for a test account. Use a test workspace, never a real customer's.
SHOT_EMAIL=
SHOT_PASSWORD=

# --- Login page (change only if the defaults don't match your app) -------------
SHOT_LOGIN_PATH=/login
SHOT_EMAIL_SELECTOR=input[type=email], input[name=email]
SHOT_PASSWORD_SELECTOR=input[type=password]
SHOT_SUBMIT_SELECTOR=button[type=submit]
# A regular expression the URL matches once you are logged in.
SHOT_AFTER_LOGIN=dashboard

# --- Window size --------------------------------------------------------------
# The browser window. 1905 x 859 matches a 1920x1080 screen with browser bars,
# so the layout looks like what readers see. Keep it the same for every image.
SHOT_WIDTH=1905
SHOT_HEIGHT=859
# Width of the app's left menu, left out of full-page captures.
SHOT_MENU_WIDTH=264

# --- Privacy --------------------------------------------------------------------
# Text blurred in every capture, comma-separated: the test account's email,
# workspace name, connected account names, IDs, keys.
SHOT_BLUR_TEXTS=

# --- Optional -------------------------------------------------------------------
# Point a hostname at another address without editing /etc/hosts, e.g. when the
# app runs on `php artisan serve`:  MAP tenant1.example.test 127.0.0.1
SHOT_HOST_MAP=
# Folder of the playwright package if it is not installed where you run the scripts.
SHOT_PLAYWRIGHT=
# Where failure screenshots go.
SHOT_OUT_DIR=shots
